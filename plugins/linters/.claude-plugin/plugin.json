{
  "name": "linters",
  "version": "1.2.0",
  "description": "Runs linters on edited files: cslint (.cs), PSScriptAnalyzer (.ps1), shellcheck (.sh), rustfmt (.rs)",
  "author": { "name": "Lucas Pimentel" },
  "repository": "https://github.com/lucaspimentel/claude-plugins",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-linters.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "statusMessage": "Running cslint...",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/cs-lint.sh", "asyncRewake": true }]
      },
      {
        "matcher": "Edit|Write",
        "statusMessage": "Running PSScriptAnalyzer...",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/ps-lint.sh", "asyncRewake": true }]
      },
      {
        "matcher": "Edit|Write",
        "statusMessage": "Running shellcheck...",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/sh-lint.sh", "asyncRewake": true }]
      },
      {
        "matcher": "Edit|Write",
        "statusMessage": "Running rustfmt...",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/rs-lint.sh", "asyncRewake": true }]
      }
    ]
  }
}
